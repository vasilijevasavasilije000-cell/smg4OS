# smg4OS Desktop Environment Packages\n# Optional packages for graphical interface\n\n# Desktop environment - XFCE\nxfce4\nxfce4-terminal\nxfce4-panel\nxfce4-session\nxfdesktop4\nxfwm4\nxfconf\n\n# Alternative minimal: Openbox\n# openbox\n# obconf\n# tint2\n\n# Display and graphics\nxorg\nxorg-drivers\nlibgl1-mesa\nlibgl1-mesa-dri\nlibxrender1\n\n# Fonts\nfont-dejavu\nfont-liberation\nfonts-liberation\nfonts-noto\n\n# File manager\nthunar\nthumbnailers\n\n# System utilities\nlxappearance\npcmanfm\npluma\natril\n\n# Audio and multimedia\npulseaudio\nalsa-utils\nmpv\nffmpeg\n\n# Image viewers and editors\neog\ngimp\ninkscape\n\n# Web browser (optional)\nfirefox\n\n# Terminal\ngnome-terminal\nxterm\n\n# Network\nnetwork-manager\nnetwork-manager-gnome\n\n# Bluetooth (if supported)\nbluetooth\nblueman\n\n# Power management\nacpi\nacpi-support\n"